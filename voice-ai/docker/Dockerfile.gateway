FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/voice-ai

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ffmpeg git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /opt/voice-ai/requirements.txt
RUN python3 -m venv /opt/voice-ai/.venv \
    && /opt/voice-ai/.venv/bin/pip install --upgrade pip \
    && /opt/voice-ai/.venv/bin/pip install --no-cache-dir -r /opt/voice-ai/requirements.txt

COPY gateway /opt/voice-ai/gateway

EXPOSE 8080

CMD ["/opt/voice-ai/.venv/bin/uvicorn", "gateway.main:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers"]
